{
  "manifest_version": 3,
  "name": "Collectr Exporter",
  "version": "1.0.0",
  "description": "Export the Collectr products grid as HTML or PDF.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.getcollectr.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.getcollectr.com/portfolio/products*"
      ],
      "js": [
        "content.js",
        "custombutton.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Collectr Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
    }
  },
  "icons": {
    "16": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
